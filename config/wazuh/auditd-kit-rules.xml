  </rule>

  <rule id="100820" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">^exec_from_shm$</field>
    <description>auditd-kit: program started from /dev/shm (exec_from_shm).</description>
    <mitre>
      <id>T1620</id>
    </mitre>
  </rule>

  <rule id="100821" level="10">
