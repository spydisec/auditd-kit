    </mitre>
  </rule>

  <rule id="100816" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1505_Server_Software_Component$</field>
    <description>auditd-kit: a service started a program (T1505_Server_Software_Component).</description>
    <mitre>
      <id>T1505</id>
    </mitre>
  </rule>

  <rule id="100817" level="3">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1059_Command_and_Scripting_Interpreter$</field>
    <description>auditd-kit: command run by a logged-in user (T1059_Command_and_Scripting_Interpreter).</description>
