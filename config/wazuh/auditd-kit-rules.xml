<!--
  Wazuh rules for auditd-kit audit keys. Copy this file to /var/ossec/etc/rules/ on the Wazuh
  manager and restart it. See docs/integrations/wazuh.md.

  Wazuh decodes every audit event (rule 80700, level 0), but only raises alerts for the keys in
  etc/lists/audit-keys. These rules raise an alert for each auditd-kit key. The IDs are in the
  custom range: change them if 100800 to 100899 is already in use on your manager.
-->
<group name="audit,auditd-kit,">
  <rule id="100800" level="3">
    <if_sid>80700</if_sid>
    <field name="audit.key">^akit_canary$</field>
    <description>auditd-kit: auditd-kit canary written by verify.sh (akit_canary).</description>
  </rule>

  <rule id="100801" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1562_Impair_Defenses$</field>
    <description>auditd-kit: audit, firewall, or MAC settings changed (T1562_Impair_Defenses).</description>
    <mitre>
      <id>T1562</id>
    </mitre>
  </rule>

  <rule id="100802" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1098_Account_Manipulation$</field>
    <description>auditd-kit: account changed (T1098_Account_Manipulation).</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <rule id="100803" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1136_Create_Account$</field>
    <description>auditd-kit: account created (T1136_Create_Account).</description>
    <mitre>
      <id>T1136</id>
    </mitre>
  </rule>

  <rule id="100804" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1556_Modify_Authentication_Process$</field>
    <description>auditd-kit: authentication settings changed (T1556_Modify_Authentication_Process).</description>
    <mitre>
      <id>T1556</id>
    </mitre>
  </rule>

  <rule id="100805" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1548_Abuse_Elevation_Control_Mechanism$</field>
    <description>auditd-kit: privilege elevation (T1548_Abuse_Elevation_Control_Mechanism).</description>
    <mitre>
      <id>T1548</id>
    </mitre>
  </rule>

  <rule id="100806" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1053_Scheduled_Task_Job$</field>
    <description>auditd-kit: scheduled job changed (T1053_Scheduled_Task_Job).</description>
    <mitre>
      <id>T1053</id>
    </mitre>
  </rule>

  <rule id="100807" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1543_Create_or_Modify_System_Process$</field>
    <description>auditd-kit: system service changed (T1543_Create_or_Modify_System_Process).</description>
    <mitre>
      <id>T1543</id>
    </mitre>
  </rule>

  <rule id="100808" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1574_Hijack_Execution_Flow$</field>
    <description>auditd-kit: library preload or search path changed (T1574_Hijack_Execution_Flow).</description>
    <mitre>
      <id>T1574</id>
    </mitre>
  </rule>

  <rule id="100809" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1547_Boot_or_Logon_Autostart_Execution$</field>
    <description>auditd-kit: kernel module loaded or module settings changed (T1547_Boot_or_Logon_Autostart_Execution).</description>
    <mitre>
      <id>T1547</id>
    </mitre>
  </rule>

  <rule id="100810" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">^T1546_Event_Triggered_Execution$</field>
