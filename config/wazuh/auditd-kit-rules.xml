    <description>auditd-kit: kernel parameters changed (sysctl).</description>
  </rule>

  <rule id="100826" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">^mounts$</field>
    <description>auditd-kit: file system mounted (mounts).</description>
  </rule>

  <rule id="100827" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">^fstab$</field>
    <description>auditd-kit: file system table changed (fstab).</description>
  </rule>

  <rule id="100828" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">^swap$</field>
    <description>auditd-kit: swap changed (swap).</description>
  </rule>

  <rule id="100829" level="5">
