# Base rules for every profile. Render fills in the backlog value and keeps the control lines.

# Delete all existing rules before loading ours.
-D

# Kernel backlog size. Render replaces the placeholder with the size preset value.
-b @AKIT_BACKLOG@

# On failure, log to syslog. Never panic the host.
-f 1

# Wait when the backlog is full instead of dropping events. The value is in jiffies, so it's
# 60 s on a kernel with HZ=1000 and longer on a kernel with a lower HZ. RHEL ships the same value.
--backlog_wait_time 60000

# Canary: verify writes to this file and looks for the akit_canary key.
-w /etc/auditd-kit/canary -p wa -k akit_canary

# Audit tampering: changes to audit configuration and use of audit tools. autrace is a tracing
# tool that has no routine use on a server.
-w /etc/audit/ -p wa -k T1562_Impair_Defenses
-w /etc/audisp/ -p wa -k T1562_Impair_Defenses
-w /etc/libaudit.conf -p wa -k T1562_Impair_Defenses
-a always,exit -F path=/usr/sbin/auditctl -F perm=x -k T1562_Impair_Defenses
-a always,exit -F path=/usr/sbin/augenrules -F perm=x -k T1562_Impair_Defenses
-a always,exit -F path=/usr/sbin/auditd -F perm=x -k T1562_Impair_Defenses
-a always,exit -F path=/usr/sbin/autrace -F perm=x -k T1562_Impair_Defenses

# Audit logs: any change to the log files themselves. Log rotation adds a few events.
-w /var/log/audit/ -p wa -k T1562_Impair_Defenses
