# Medium profile, for critical servers. It adds the commands that users with a login ID run, and
# network connections, process tricks, and changes to boot, network, and package settings. It
# adds noticeable log volume (the command and connection rules are the largest sources), so
# measure it with stats.sh on a few hosts first (see docs/sizing-guide.md).

# Commands: 91-medium-last.rules logs every program that a logged-in user starts.

# Staging: a program started from a temporary directory, by any user or service. Package
# scripts run from /var/tmp, so expect bursts during installs.
-a always,exit -F dir=/tmp -F perm=x -k exec_from_tmp
-a always,exit -F dir=/var/tmp -F perm=x -k exec_from_tmp

# Network connections: IPv4 and IPv6 connects by a logged-in user (the sizes 16 and 28 are the
# address sizes, so local sockets are skipped), and raw packet sockets that sniffers open.
-a always,exit -F arch=b64 -S connect -F a2=16 -F auid>=1000 -F auid!=unset -k network_connect
-a always,exit -F arch=b32 -S connect -F a2=16 -F auid>=1000 -F auid!=unset -k network_connect
-a always,exit -F arch=b64 -S connect -F a2=28 -F auid>=1000 -F auid!=unset -k network_connect
-a always,exit -F arch=b32 -S connect -F a2=28 -F auid>=1000 -F auid!=unset -k network_connect
-a always,exit -F arch=b64 -S socket -F a0=17 -F auid>=1000 -F auid!=unset -k T1040_Network_Sniffing
-a always,exit -F arch=b32 -S socket -F a0=17 -F auid>=1000 -F auid!=unset -k T1040_Network_Sniffing

# Root from a user: a logged-in user's process that switched to root's ID.
-a always,exit -F arch=b64 -S setuid,setreuid,setresuid -F euid=0 -F auid>=1000 -F auid!=unset -F success=1 -k T1548_Abuse_Elevation_Control_Mechanism
-a always,exit -F arch=b32 -S setuid,setreuid,setresuid -F euid=0 -F auid>=1000 -F auid!=unset -F success=1 -k T1548_Abuse_Elevation_Control_Mechanism
# 32-bit programs use the 32-bit ID calls.
-a always,exit -F arch=b32 -S setuid32,setreuid32,setresuid32 -F euid=0 -F auid>=1000 -F auid!=unset -F success=1 -k T1548_Abuse_Elevation_Control_Mechanism

# Root in a user's files: root wrote to or changed a file under /home that another user owns,
# while a logged-in user was behind the session.
-a always,exit -F dir=/home -F uid=0 -F auid>=1000 -F auid!=unset -C auid!=obj_uid -F perm=wa -k power_abuse

# Process injection: ptrace requests that attach to a process or write into its memory
# (POKETEXT 0x4, POKEDATA 0x5, ATTACH 0x10, SEIZE 0x4206), and writes into another process's
# memory. Debuggers and some security agents also trigger these. The two register requests
# (POKEUSER 0x6, SETREGS 0xd) are limited to logged-in users, because debuggers use them a lot.
-a always,exit -F arch=b64 -S ptrace -F a0=0x4 -k T1055_Process_Injection
-a always,exit -F arch=b32 -S ptrace -F a0=0x4 -k T1055_Process_Injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x5 -k T1055_Process_Injection
-a always,exit -F arch=b32 -S ptrace -F a0=0x5 -k T1055_Process_Injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x10 -k T1055_Process_Injection
-a always,exit -F arch=b32 -S ptrace -F a0=0x10 -k T1055_Process_Injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x4206 -k T1055_Process_Injection
-a always,exit -F arch=b32 -S ptrace -F a0=0x4206 -k T1055_Process_Injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x6 -F auid>=1000 -F auid!=unset -k T1055_Process_Injection
-a always,exit -F arch=b32 -S ptrace -F a0=0x6 -F auid>=1000 -F auid!=unset -k T1055_Process_Injection
-a always,exit -F arch=b64 -S ptrace -F a0=0xd -F auid>=1000 -F auid!=unset -k T1055_Process_Injection
-a always,exit -F arch=b32 -S ptrace -F a0=0xd -F auid>=1000 -F auid!=unset -k T1055_Process_Injection
-a always,exit -F arch=b64 -S process_vm_writev -k T1055_Process_Injection
-a always,exit -F arch=b32 -S process_vm_writev -k T1055_Process_Injection

# In-memory code: a logged-in user created an anonymous memory file, which fileless malware uses.
-a always,exit -F arch=b64 -S memfd_create -F auid>=1000 -F auid!=unset -k T1620_Reflective_Code_Loading
-a always,exit -F arch=b32 -S memfd_create -F auid>=1000 -F auid!=unset -k T1620_Reflective_Code_Loading

# Containers and kernel programs: a logged-in user changed namespaces (the first step of a
# container escape) or loaded an eBPF program (BPF_PROG_LOAD is request 5).
-a always,exit -F arch=b64 -S unshare,setns -F auid>=1000 -F auid!=unset -k T1611_Escape_to_Host
-a always,exit -F arch=b32 -S unshare,setns -F auid>=1000 -F auid!=unset -k T1611_Escape_to_Host
-a always,exit -F arch=b64 -S bpf -F a0=5 -F auid>=1000 -F auid!=unset -k bpf
-a always,exit -F arch=b32 -S bpf -F a0=5 -F auid>=1000 -F auid!=unset -k bpf

# Persistence: changes to unit files that packages own, to boot scripts, and to the library
# files of PAM, whose replacement is a known backdoor. Package updates cause bursts here.
-w /usr/lib/systemd/system/ -p wa -k T1543_Create_or_Modify_System_Process
-w /etc/rc.local -p wa -k T1037_Boot_or_Logon_Initialization_Scripts
-w /etc/init.d/ -p wa -k T1037_Boot_or_Logon_Initialization_Scripts
-w /etc/update-motd.d/ -p wa -k T1037_Boot_or_Logon_Initialization_Scripts
-w /usr/lib64/security/ -p wa -k T1556_Modify_Authentication_Process
-w /usr/lib/x86_64-linux-gnu/security/ -p wa -k T1556_Modify_Authentication_Process

# Shell startup: changes to system-wide shell profile files and the login environment.
-w /etc/profile -p wa -k T1546_Event_Triggered_Execution
-w /etc/profile.d/ -p wa -k T1546_Event_Triggered_Execution
-w /etc/bashrc -p wa -k T1546_Event_Triggered_Execution
-w /etc/bash.bashrc -p wa -k T1546_Event_Triggered_Execution
-w /etc/environment -p wa -k T1546_Event_Triggered_Execution

# Network config: name files, the distro network config dirs, and hostname changes.
-w /etc/hosts -p wa -k network_config
-w /etc/hostname -p wa -k network_config
-w /etc/sysconfig/network-scripts/ -p wa -k network_config
-w /etc/NetworkManager/ -p wa -k network_config
-w /etc/netplan/ -p wa -k network_config
-w /etc/network/ -p wa -k network_config
-a always,exit -F arch=b64 -S sethostname,setdomainname -k network_config
-a always,exit -F arch=b32 -S sethostname,setdomainname -k network_config

# Firewall and container settings: changes to firewall rule files and container engine config.
-w /etc/firewalld/ -p wa -k T1562_Impair_Defenses
-w /etc/ufw/ -p wa -k T1562_Impair_Defenses
-w /etc/nftables.conf -p wa -k T1562_Impair_Defenses
-w /etc/sysconfig/iptables -p wa -k T1562_Impair_Defenses
-w /etc/sysconfig/nftables.conf -p wa -k T1562_Impair_Defenses
-w /etc/docker/ -p wa -k containers
-w /etc/containerd/ -p wa -k containers
-w /etc/containers/ -p wa -k containers

# Package sources: changes to repository and package manager settings.
-w /etc/yum.repos.d/ -p wa -k software_mgmt
-w /etc/dnf/ -p wa -k software_mgmt
-w /etc/apt/sources.list -p wa -k software_mgmt
-w /etc/apt/sources.list.d/ -p wa -k software_mgmt
-w /etc/apt/apt.conf.d/ -p wa -k software_mgmt
-w /etc/apt/trusted.gpg.d/ -p wa -k software_mgmt

# System settings: kernel parameters and the mount table.
-w /etc/sysctl.conf -p wa -k sysctl
-w /etc/sysctl.d/ -p wa -k sysctl
-w /etc/fstab -p wa -k fstab

# Mounts and swap: mount, unmount, and swap calls by logged-in users. The newer mount calls are
# not in every kernel, and render drops the ones a host does not have.
-a always,exit -F arch=b64 -S mount,umount2,mount_setattr,fsopen,fsmount,move_mount -F auid>=1000 -F auid!=unset -k mounts
-a always,exit -F arch=b32 -S mount,umount2,mount_setattr,fsopen,fsmount,move_mount -F auid>=1000 -F auid!=unset -k mounts
-a always,exit -F arch=b64 -S swapon,swapoff -F auid>=1000 -F auid!=unset -k swap
-a always,exit -F arch=b32 -S swapon,swapoff -F auid>=1000 -F auid!=unset -k swap
