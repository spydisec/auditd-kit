# Heavy profile, for hosts that must meet CIS or STIG audit checks. It adds failed file access,
# file permission changes, deletions, login records, and time adjustments. It adds the most log
# volume, so measure it with stats.sh on a few hosts first (see docs/sizing-guide.md). The
# login-record watches fire on every login and logout, and the deletion and rename rules are busy
# on interactive hosts. The commented rules at the end are the busiest, so they stay off by default.
#
# Immutable mode (-e 2) is important for compliance, and you turn it on with akit_immutable=true.
# Once -e 2 is loaded, the kernel refuses every later rule change until the host reboots.

# Failed access: a logged-in user tried to open or truncate a file and was refused.
-a always,exit -F arch=b64 -S open,openat,openat2,creat,truncate,ftruncate,open_by_handle_at -F exit=-EACCES -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b32 -S open,openat,openat2,creat,truncate,ftruncate,open_by_handle_at -F exit=-EACCES -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b64 -S open,openat,openat2,creat,truncate,ftruncate,open_by_handle_at -F exit=-EPERM -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b32 -S open,openat,openat2,creat,truncate,ftruncate,open_by_handle_at -F exit=-EPERM -F auid>=1000 -F auid!=unset -k access
# 32-bit programs use the 64-bit-offset truncate calls.
-a always,exit -F arch=b32 -S truncate64,ftruncate64 -F exit=-EACCES -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b32 -S truncate64,ftruncate64 -F exit=-EPERM -F auid>=1000 -F auid!=unset -k access

# Permissions: a logged-in user changed a file's mode, owner, or extended attributes.
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k T1222_File_and_Directory_Permissions_Modification
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k T1222_File_and_Directory_Permissions_Modification
-a always,exit -F arch=b64 -S chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=unset -k T1222_File_and_Directory_Permissions_Modification
-a always,exit -F arch=b32 -S chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=unset -k T1222_File_and_Directory_Permissions_Modification
# 32-bit programs use the 32-bit owner calls.
-a always,exit -F arch=b32 -S chown32,fchown32,lchown32 -F auid>=1000 -F auid!=unset -k T1222_File_and_Directory_Permissions_Modification
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k T1222_File_and_Directory_Permissions_Modification
-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k T1222_File_and_Directory_Permissions_Modification

# Deletion: a logged-in user deleted or renamed a file or directory.
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat,renameat2,rmdir -F auid>=1000 -F auid!=unset -k T1070_Indicator_Removal
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat,renameat2,rmdir -F auid>=1000 -F auid!=unset -k T1070_Indicator_Removal

# Login records: changes to the files that record logins and failed logins. Each distro keeps
# its failed-login counters in a different place, so the watches cover all of them.
-w /var/log/lastlog -p wa -k logins
-w /var/run/faillock/ -p wa -k logins
-w /var/log/faillock -p wa -k logins
-w /var/log/tallylog -p wa -k logins
-w /var/log/faillog -p wa -k logins
-w /var/log/wtmp -p wa -k logins
-w /var/log/btmp -p wa -k logins
-w /var/run/utmp -p wa -k logins

# Time: clock adjustments by a logged-in user. Time daemons call adjtimex all the time, so
# without the filter this rule would log them. CIS lists it without a filter. If your scanner
# needs that form, add it as an overlay rule.
-a always,exit -F arch=b64 -S adjtimex -F auid>=1000 -F auid!=unset -k time_change
-a always,exit -F arch=b32 -S adjtimex -F auid>=1000 -F auid!=unset -k time_change

# Labels and ACLs: a logged-in user ran a tool that changes SELinux labels or file ACLs.
-a always,exit -F path=/usr/bin/chcon -F perm=x -F auid>=1000 -F auid!=unset -k T1222_File_and_Directory_Permissions_Modification
-a always,exit -F path=/usr/bin/setfacl -F perm=x -F auid>=1000 -F auid!=unset -k T1222_File_and_Directory_Permissions_Modification
-a always,exit -F path=/usr/bin/chacl -F perm=x -F auid>=1000 -F auid!=unset -k T1222_File_and_Directory_Permissions_Modification

# Banners, resolver, and sudo log: files that CIS and STIG ask to watch. The resolver file is
# rewritten by DHCP and network managers on many hosts. The sudo log exists only if sudoers sets a
# logfile.
-w /etc/issue -p wa -k login_banner
-w /etc/issue.net -p wa -k login_banner
-w /etc/resolv.conf -p wa -k network_config
-w /var/log/sudo.log -p wa -k sudo_log

# Privileged commands: the minimal profile already logs every setuid program that a logged-in user
# starts. CIS and STIG scanners also look for one literal rule per setuid or setgid program. The
# list differs per host, so add them as overlay rules. This command prints one rule per program:
#   find / -xdev -type f -perm /6000 2>/dev/null | while read -r p; do
#     echo "-a always,exit -F path=$p -F perm=x -F auid>=1000 -F auid!=unset -k privileged"
#   done

# Every command by every process, including services and cron jobs. Caution: on a busy host this
# can produce a very large volume of logs. Measure it on one host before you turn it on.
# -a always,exit -F arch=b64 -S execve,execveat -k T1059_Command_and_Scripting_Interpreter
# -a always,exit -F arch=b32 -S execve,execveat -k T1059_Command_and_Scripting_Interpreter

# Commands by services: programs that a daemon with no login ID starts, which is how a web shell
# shows up. Caution: daemons that start helper programs make this very busy. To narrow it, add
# -F euid=<the service's user ID> to each line.
# -a always,exit -F arch=b64 -S execve,execveat -F auid=unset -F euid!=0 -k T1505_Server_Software_Component
# -a always,exit -F arch=b32 -S execve,execveat -F auid=unset -F euid!=0 -k T1505_Server_Software_Component

# Every network connection by every process, with no login ID filter. Caution: this logs a line
# for each DNS lookup and each service call, so the volume is very high.
# -a always,exit -F arch=b64 -S connect -F a2=16 -k network_connect
# -a always,exit -F arch=b32 -S connect -F a2=16 -k network_connect
# -a always,exit -F arch=b64 -S connect -F a2=28 -k network_connect
# -a always,exit -F arch=b32 -S connect -F a2=28 -k network_connect
